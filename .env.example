# ==============================================================================
# CoreT & Admin Panel Environment Variables
# ==============================================================================

# API Base URL for Frontend (User Panel & Admin Panel)
# LOCAL: Leave blank or set to http://localhost:3001 (or http://localhost:3000 when using Vite middleware)
# PRODUCTION (Vercel Project A -> Project B): https://your-admin-backend-domain.vercel.app
VITE_API_BASE_URL=""

# Gemini AI API Key (Server-Side Only)
# Get your standard API key from https://aistudio.google.com/app/apikey (starts with AIzaSy...)
GEMINI_API_KEY="your_gemini_api_key_here"

# Allowed Cross-Origin Origins for CORS (comma-separated)
# In development, localhost is permitted automatically.
# In production, set to your citizen frontend domain(s):
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://coret-user.vercel.app"

# Server Port (Defaults to 3001 for standalone API server)
PORT=3001
